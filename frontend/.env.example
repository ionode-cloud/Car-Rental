# Vercel / Production Frontend Environment Variables
# Set this to your deployed backend URL + /api (e.g. https://your-backend.onrender.com/api)
# In local development: /api
VITE_API_URL=https://car-rental-9ldm.onrender.com/api

# Optional: Razorpay Public Key ID (for payments)
# Leave empty if using the built-in development test simulator
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
